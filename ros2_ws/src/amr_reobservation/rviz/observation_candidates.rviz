Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: observation_lidar
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 20
    - Class: rviz_default_plugins/LaserScan
      Name: Raw scan (white)
      Enabled: true
      Topic:
        Value: /observation_lidar/scan
        Depth: 5
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
      Style: Flat Squares
      Size (m): 0.015
      Color Transformer: FlatColor
      Color: 235; 235; 235
      Position Transformer: XYZ
      Decay Time: 0
    - Class: rviz_default_plugins/MarkerArray
      Name: Side estimate
      Enabled: true
      Topic:
        Value: /debug/vehicle_side
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
      Namespaces:
        clusters: true
        inliers: true
        side_line: true
        tangent: true
        normal: true
        summary: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Confirmed viewpoints (A green, B pink)
      Enabled: true
      Topic:
        Value: /debug/observation_candidates
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
      Namespaces:
        viewpoints: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Raw viewpoints (optional comparison)
      Enabled: false
      Topic:
        Value: /debug/observation_candidates/raw
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
      Namespaces:
        viewpoints: true
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Parallel validation
      Target Frame: <Fixed Frame>
      Scale: 100
      Angle: 0
      X: -0.4
      Y: -1
Window Geometry:
  Width: 1500
  Height: 900
