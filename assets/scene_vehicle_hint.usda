#usda 1.0

# Use the clock graph's tick, DDS context and reset-on-stop simulation timestamp.
# An empty parentPrim asks Isaac for both poses in the stage world frame.
over "Graph"
{
    over "ROS_Clock"
    {
        def OmniGraphNode "SceneVehiclePoses"
        {
            token node:type = "isaacsim.ros2.bridge.ROS2PublishTransformTree"
            int node:typeVersion = 1
            custom uint64 inputs:context
            prepend uint64 inputs:context.connect = </Graph/ROS_Clock/Context.outputs:context>
            custom uint inputs:execIn (
                customData = { bool isExecution = 1 }
            )
            prepend uint inputs:execIn.connect = </Graph/ROS_Clock/OnPlaybackTick.outputs:tick>
            custom double inputs:timeStamp
            prepend double inputs:timeStamp.connect = </Graph/ROS_Clock/ReadSimTime.outputs:simulationTime>
            custom rel inputs:targetPrims = [</iw_hub_ROS/chassis/base_link>, </World/sedan_car>] (
                customData = {
                    dictionary omni = {
                        dictionary graph = { string relType = "target" }
                    }
                }
            )
            custom string inputs:topicName = "/reobservation/scene_tf"
            custom bool inputs:staticPublisher = 0
        }
    }
}
