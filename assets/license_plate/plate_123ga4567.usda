#usda 1.0
(
    defaultPrim = "Plate"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Plate"
{
    def Mesh "Face" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        point3f[] points = [(-0.26, -0.055, 0), (0.26, -0.055, 0), (0.26, 0.055, 0), (-0.26, 0.055, 0)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        normal3f[] normals = [(0, 0, 1)] (
            interpolation = "constant"
        )
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
            interpolation = "vertex"
        )
        uniform token subdivisionScheme = "none"
        uniform bool doubleSided = false
        rel material:binding = </Plate/Looks/PrintedPlate>
    }

    def Cube "Backing"
    {
        double size = 1
        double3 xformOp:translate = (0, 0, -0.0016)
        double3 xformOp:scale = (0.52, 0.11, 0.003)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.15, 0.15, 0.15)]
    }

    def Scope "Looks"
    {
        def Material "PrintedPlate"
        {
            token outputs:mdl:surface.connect = </Plate/Looks/PrintedPlate/Shader.outputs:out>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (1, 1, 1)
                asset inputs:diffuse_texture = @plate_123ga4567.png@
                float inputs:reflection_roughness_constant = 0.7
                float inputs:metallic_constant = 0
                bool inputs:enable_emission = false
                token outputs:out
            }
        }
    }
}
