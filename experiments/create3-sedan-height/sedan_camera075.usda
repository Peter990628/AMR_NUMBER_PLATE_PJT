        dictionary renderSettings = {
            bool "rtx:shadows:enabled" = 0
        }
    }
)

over "create3"
{
    over "base_link"
    {
        over "Camera" {
            double3 xformOp:translate = (0.3150411552, 0.0831634521, 0.75)
        }
        over "front_stereo_camera_left_optical" {
            double3 xformOp:translate = (0.3150411552, 0.0831634521, 0.75)
        }
    }
}
